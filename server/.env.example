PORT=5000
NODE_ENV=development

# Create the public demo account and sample chats on startup
SEED_DEMO=true

# Origin of the web client (used for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/tong

# Use long random strings, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
